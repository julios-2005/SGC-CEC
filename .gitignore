# Build
/target/
/backend-springboot/target/

# Documentos subidos por usuarios (PII: cédulas, comprobantes de pago, etc.)
/uploads/*
!/uploads/.gitkeep

# Configuración local con secretos (no versionar nunca)
application-local.properties
.env
/backend-springboot/.env.local

# IDE (ya cubierto en .idea/.gitignore, se repite por si se borra esa carpeta)
.idea/
*.iml
.vscode/

/backend-springboot/configuracion-tic.properties

# Frontend: dependencias, caché y salida de compilación
/frontend-angular/node_modules/
/frontend-angular/.angular/
/frontend-angular/dist/
