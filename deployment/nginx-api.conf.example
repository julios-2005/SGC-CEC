# Reverse proxy del API (Spring Boot en 127.0.0.1:8080). Ajusta server_name y los certificados.
# Variables de entorno del backend asociadas: FORWARD_HEADERS_STRATEGY, TRUSTED_PROXIES, SERVER_ADDRESS.
server {
    listen 443 ssl;
    http2 on;
    server_name api.sgc.cec.upse.edu.ec;

    ssl_certificate     /etc/ssl/certs/sgc.crt;
    ssl_certificate_key /etc/ssl/private/sgc.key;

    # El backend admite 25 MB de multipart (5 MB por archivo). El valor por defecto de
    # Nginx es 1 MB y rechazaria las inscripciones con comprobantes.
    client_max_body_size 26m;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        # $remote_addr y NO $proxy_add_x_forwarded_for: no se hereda lo que envie el cliente,
        # asi nadie puede falsificar su IP para evadir los limites de intentos.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
