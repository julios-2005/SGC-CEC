DB_URL=jdbc:postgresql://IP_SERVIDOR_BD:5432/cec_capacitacion
DB_USERNAME=admin_cec
DB_PASSWORD=CAMBIAR

MAIL_USERNAME=correo@upse.edu.ec
MAIL_PASSWORD=CAMBIAR
APP_UPLOAD_DIR=/var/lib/sgc-cec/uploads

JWT_SECRET=GENERAR_UN_VALOR_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_MS=28800000
FRONTEND_ORIGINS=https://sgccec.upse.edu.ec

# Token Bearer entregado por TIC: pegar SOLO el valor, sin el prefijo Bearer.
TICS_API_TOKEN=
TICS_API_BASE_URL=https://sga.upse.edu.ec/restsiia/api/public
TICS_CONNECT_TIMEOUT=3s
TICS_READ_TIMEOUT=8s
TICS_CONSULTAS_POR_MINUTO=30
TICS_CONSULTAS_POR_DIA=300
TICS_CONSULTAS_POR_DOCUMENTO_HORA=10

# Arquitectura de tres servidores: Nginx (Servidor 1) -> Backend (Servidor 2).
# Sin esto, todas las peticiones parecen venir de la IP del proxy y los limites
# de intentos de login y de consultas a TIC se comparten entre todos los usuarios.
FORWARD_HEADERS_STRATEGY=native
# IP privada del Servidor 1 (Nginx), con los puntos entre corchetes: 10[.]0[.]0[.]10
TRUSTED_PROXIES=IP_SERVIDOR_NGINX
# IP privada del Servidor 2 (esta maquina). El puerto 8080 solo debe aceptar al Servidor 1 (firewall).
SERVER_ADDRESS=IP_PRIVADA_SERVIDOR_BACKEND

SHOW_SQL=false
