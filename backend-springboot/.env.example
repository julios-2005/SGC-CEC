# En VS Code, copia este archivo a .env.local y completa los valores reales.
# La configuración F5 de la carpeta raíz carga .env.local automáticamente.
# Maven/Java por terminal no lo cargan: exporta allí estas variables primero.
# NUNCA subas .env.local ni application-local.properties al repositorio.

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/cec_capacitacion
DB_USERNAME=
DB_PASSWORD=

# Correo (Gmail): usa un "App Password" de la cuenta, no la contraseña normal
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=

# Carpeta donde se guardan los archivos subidos (fotos, comprobantes, cedulas).
# En LOCAL, desde backend-springboot, usa ../uploads (carpeta en la raíz).
# En PRODUCCION, usar una ruta ABSOLUTA fuera de la carpeta del .jar, ej:
# APP_UPLOAD_DIR=/var/upse-cec/uploads
APP_UPLOAD_DIR=../uploads

# Seguridad del WebService
# Mínimo 32 caracteres. En producción genera un valor aleatorio y privado.
JWT_SECRET=cambia-esta-clave-por-una-de-32-caracteres-o-mas
JWT_EXPIRATION_MS=28800000

# URL pública del servidor Angular. Separa múltiples orígenes con coma.
FRONTEND_ORIGINS=http://localhost:4200
