# Copiar a configuracion-tic.properties y pegar el token recibido de TIC.
# Archivo de uso local del backend. No incluirlo en git ni en Angular.
app.tics.token=
app.tics.base-url=https://sga.upse.edu.ec/restsiia/api/public
app.tics.connect-timeout=3s
app.tics.read-timeout=8s
app.tics.consultas-por-minuto=30
# Coincidencias exactas normalizadas. Añadir únicamente valores confirmados por TIC.
app.tics.tipos-docente=ACADEMICO,DOCENTE,DOCENTE UPSE,PERSONAL ACADEMICO
app.tics.tipos-administrativo=ADMINISTRATIVO,ADMINISTRATIVO UPSE,PERSONAL ADMINISTRATIVO
# Valor de tipoUsuario con que TIC identifica a un graduado (confirmar con TIC).
app.tics.tipos-graduado=GRADUADO
app.tics.cargos-docente=DOCENTE,PROFESOR,PROFESORA
app.tics.cargos-administrativo=ANALISTA 2 DE DESARROLLO DE SISTEMAS
# Valor afirmativo propuesto. Confirmar este código con TIC para casos positivos.
